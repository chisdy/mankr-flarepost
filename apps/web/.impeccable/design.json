      "refersTo": "button-ghost",
      "description": "Back action.",
      "html": "<button type=\"button\" class=\"ds-button-ghost\">Back</button>",
      "css": ".ds-button-ghost{display:inline-flex;align-items:center;justify-content:center;min-height:2.25rem;padding:0 .75rem;border:1px solid transparent;border-radius:var(--radius,.625rem);font:500 .875rem/1.25rem \"Inter Variable\",sans-serif;cursor:pointer;transition:color 150ms,background-color 150ms;background:transparent;color:var(--foreground);}.ds-button-ghost:hover{background:var(--muted);}.ds-button-ghost:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}.ds-button-ghost:active{transform:translateY(1px);}"
    },
    {
      "name": "Search field",
      "kind": "input",
      "refersTo": "input-search",
      "description": "Paper field with a clear boundary.",
      "html": "<input class=\"ds-search\" type=\"search\" aria-label=\"Search mail\" placeholder=\"Search mail\">",
      "css": ".ds-search{min-height:2.5rem;max-width:100%;padding:.25rem .75rem;background:var(--card);color:var(--foreground);border:1px solid var(--input);border-radius:var(--radius,.625rem);font:400 1rem/1.5rem \"Inter Variable\",sans-serif;transition:color 200ms,box-shadow 200ms}.ds-search::placeholder{color:var(--muted-foreground)}.ds-search:focus-visible{outline:0;border-color:var(--ring);box-shadow:0 0 0 3px color-mix(in oklab,var(--ring) 30%,transparent)}@media(min-width:48rem){.ds-search{font-size:.875rem}}"
    },
    {
      "name": "Current folder",
      "kind": "nav",
      "refersTo": "folder-current",
      "description": "Selected folder on the charcoal fold.",
      "html": "<nav class=\"ds-rail\" aria-label=\"Folders\"><a class=\"ds-folder\" href=\"#inbox\" aria-current=\"page\"><svg aria-hidden=\"true\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linejoin=\"round\"><path d=\"M4 6h16v12H4zM4 7l8 6 8-6\"/></svg> Inbox</a><a class=\"ds-folder\" href=\"#sent\">Sent</a></nav>",
      "css": ".ds-rail{--background:var(--rail-background,#2e2b34);--foreground:var(--rail-foreground,#f4f2f6);--primary:var(--rail-primary,#d5cce3);--primary-foreground:var(--rail-primary-foreground,#302b39);--muted:var(--rail-muted,#3a373f);--muted-foreground:var(--rail-muted-foreground,#c3becb);--accent:var(--rail-accent,#45414c);--accent-foreground:var(--rail-accent-foreground,#f4f2f6);--border:var(--rail-border,#3b3742);--ring:var(--rail-ring,#d5cce3);background:var(--background);padding:1rem;display:grid;gap:.125rem}.ds-folder{min-height:2.5rem;display:flex;align-items:center;gap:.75rem;padding:.5rem .75rem;border-radius:var(--radius,.625rem);font:400 .875rem/1.25rem \"Inter Variable\",sans-serif;color:var(--muted-foreground);text-decoration:none;transition:color 150ms,background-color 150ms}.ds-folder:hover{background:var(--accent);color:var(--foreground)}.ds-folder[aria-current=\"page\"]{background:var(--accent);color:var(--accent-foreground);font-weight:600;box-shadow:inset 1px 0 var(--ring)}.ds-folder:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}"
