      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Compose action.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Compose</button>",
      "css": ".ds-button-primary{display:inline-flex;align-items:center;justify-content:center;min-height:2.25rem;padding:0 .75rem;border:1px solid transparent;border-radius:var(--radius,.625rem);font:500 .875rem/1.25rem \"Inter Variable\",sans-serif;cursor:pointer;transition:color 150ms,background-color 150ms;background:var(--primary);color:var(--primary-foreground);}.ds-button-primary:hover{background:color-mix(in oklab,var(--primary) 80%,transparent);}.ds-button-primary:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}.ds-button-primary:active{transform:translateY(1px);}"
    },
    {
      "name": "Outline button",
      "kind": "button",
      "refersTo": "button-outline",
