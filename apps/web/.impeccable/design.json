      "html": "<button type=\"button\" class=\"ds-button-outline\">Load more</button>",
      "css": ".ds-button-outline{display:inline-flex;align-items:center;justify-content:center;min-height:2.25rem;padding:0 .75rem;border:1px solid transparent;border-radius:var(--radius,.625rem);font:500 .875rem/1.25rem \"Inter Variable\",sans-serif;cursor:pointer;transition:color 150ms,background-color 150ms;background:var(--background);color:var(--foreground);border-color:var(--border);}.ds-button-outline:hover{background:var(--muted);}.ds-button-outline:focus-visible{outline:2px solid var(--ring);outline-offset:2px;}.ds-button-outline:active{transform:translateY(1px);}"
    },
